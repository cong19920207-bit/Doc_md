# 复制为同目录 .env：cp .env.example .env
# 仅服务端读取，不进 git、不进前端、不进日志。
# 在 site/ 执行 docker compose 时会加载本文件。

# —— 模型 Key（空则只能起站，不能重建索引 / 真正问答）——
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# —— 外网 API 根地址（一般不用改）——
DASHSCOPE_BASE=https://dashscope.aliyuncs.com
DEEPSEEK_BASE=https://api.deepseek.com

# —— kb-api 在 Docker 网内连其它容器（不要改成 127.0.0.1）——
QDRANT_URL=http://qdrant:6333
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=hayyo
MYSQL_PASSWORD=hayyo_kb_local
MYSQL_DATABASE=hayyo_kb
MYSQL_ROOT_PASSWORD=hayyo_kb_local

# —— 本机浏览器访问（127.0.0.1），不是容器内部端口 ——
HAYYO_WEB_PORT=18765
HAYYO_MYSQL_HOST_PORT=18766
HAYYO_QDRANT_HOST_PORT=18767
# 可选标准 HTTPS：改成 443（需权限）。默认 18769，宿主机 443 仍连不上。
HAYYO_TLS_PORT=18769
# 可选标准 HTTP：把 HAYYO_WEB_PORT 改成 80。默认保持 18765。

# —— 空库引导超管（仅账号表为空时创建一次，改口令再重启不会重置）——
KB_BOOTSTRAP_USER=admin
KB_BOOTSTRAP_PASSWORD=changeme
# 文档与 TLS 路径由 Compose 固定为 /core-docs、/tls。
# 不使用 REPO_ROOT；本地直接运行后端可设置 CORE_DOCS_ROOT 与 TLS_DIR。
